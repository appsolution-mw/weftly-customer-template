# Weftly project to render (live snapshots). The build works WITHOUT this;
# at runtime a missing project/snapshot renders a graceful fallback (DynamicStub).
NEXT_PUBLIC_WEFTLY_PROJECT_ID=
# Default locale (optional; defaults to "de")
NEXT_PUBLIC_WEFTLY_DEFAULT_LOCALE=de

# CDN base for published snapshots — set ONE of:
NEXT_PUBLIC_BUNNY_PULLZONE_HOSTNAME=
# PUBLIC_CONTENT_BASE_URL=https://cdn.example.com
# PUBLIC_CONTENT_PRODUCTION_BASE_URL=https://cdn.example.com/production
# Storage prefix (optional; defaults to "public-content")
# PUBLIC_CONTENT_PREFIX=public-content
